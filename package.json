    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.2.6",
    "@fontsource/lato": "^5.2.6",
    "@fontsource/playfair-display": "^5.2.6",
    "@hookform/resolvers": "^5.2.1",
    "@notionhq/client": "^4.0.2",
    "@supabase/supabase-js": "^2.55.0",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^166.0.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.537.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "papaparse": "^5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "resend": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jest": "^30.1.1",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "whatwg-fetch": "^3.6.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
