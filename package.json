{
  "name": "wedding-landing-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky",
    "audit:check": "npm audit --audit-level=high",
    "deps:sync:check": "npm ci --ignore-scripts --dry-run",
    "check:deps": "node scripts/check-dep-drift.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:ci": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "test:vercel": "node scripts/vercel-simulation.js"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
